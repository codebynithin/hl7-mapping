# Shared by backend and frontend. Copy to .env and adjust locally.
#   cp .env.example .env

# MongoDB. Render cannot reach localhost; production needs a host such as Atlas.
MONGO_URI=mongodb://localhost:27017
DB_NAME=config-service

# Backend API (Express) and the dev-server proxy target
PORT=3000

# Angular dev server (`ng serve`)
FRONTEND_PORT=4200

# Browser origin allowed by the API. Match FRONTEND_PORT.
# The dev proxy makes this unnecessary for `ng serve`, but direct API calls need it.
CORS_ORIGIN=http://localhost:4200
